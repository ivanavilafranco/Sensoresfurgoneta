substitutions:
  # En casa: puente del PC (192.168.1.x:1884).
  # En la furgoneta: IP de la Raspberry en su red (normalmente 1883).
  broker_ip: "192.168.1.x"
  broker_port: "1884"
  portal_venus: "d83xxxxxx"
  dingtian: "relay66743"

esphome:
  name: sensor-camper
  friendly_name: Panel Camper

esp8266:
  board: nodemcuv2

# ==================================================
# CONEXION WIFI (claves en secrets.yaml)
# El portal cautivo se ha quitado para liberar memoria.
# ==================================================
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  ap:
    ssid: "Panel-Camper-Rescate"
    password: !secret ap_password

logger:

ota:
  - platform: esphome

web_server:
  port: 80

# Necesario para leer los mensajes JSON de Venus OS.
json:

# Hora desde internet (NTP), con horario de verano de España.
time:
  - platform: sntp
    id: reloj
    timezone: "CET-1CEST,M3.5.0,M10.5.0/3"

# Momento (en ms desde el arranque) del ultimo dato recibido por MQTT.
globals:
  - id: ultimo_dato_mqtt
    type: unsigned long
    restore_value: no
    initial_value: "0"

# ==================================================
# MQTT - RASPBERRY / VENUS OS / DINGTIAN
# ==================================================
mqtt:
  id: conexion_mqtt
  broker: ${broker_ip}
  port: ${broker_port}
  discovery: false
  topic_prefix: camper/panel
  reboot_timeout: 0s

# Venus OS solo publica valores si recibe un keepalive periodico.
interval:
  - interval: 30s
    then:
      - mqtt.publish:
          topic: "R/${portal_venus}/keepalive"
          payload: ""

# ==================================================
# OLED INTEGRADA
# SDA = D5 / GPIO14
# SCL = D6 / GPIO12
# ==================================================
i2c:
  id: bus_i2c
  sda: GPIO14
  scl: GPIO12
  scan: true
  frequency: 100kHz

font:
  - file: "gfonts://Roboto"
    id: fuente_10
    size: 10

  - file: "gfonts://Roboto"
    id: fuente_12
    size: 12

  - file: "gfonts://Roboto"
    id: fuente_18
    size: 18

  - file: "gfonts://Roboto"
    id: fuente_28
    size: 28

# ==================================================
# SENSORES
# ==================================================
sensor:
  - platform: wifi_signal
    id: senal_wifi
    name: "Senal WiFi"
    update_interval: 15s

  - platform: uptime
    id: tiempo_encendido
    name: "Tiempo encendido"
    update_interval: 30s

  # Energia
  - platform: template
    id: bateria_v
    name: "Bateria V"
    accuracy_decimals: 2
    internal: true

  - platform: template
    id: bateria_soc
    name: "Bateria SOC"
    accuracy_decimals: 0
    internal: true

  - platform: template
    id: solar_w
    name: "Solar W"
    accuracy_decimals: 0
    internal: true

  # Consumo
  - platform: template
    id: consumo_w
    name: "Consumo W"
    accuracy_decimals: 0
    internal: true

  - platform: template
    id: bat_corriente
    name: "Corriente bateria A"
    accuracy_decimals: 2
    internal: true

  # Ambiente
  - platform: template
    id: amb_temp
    name: "Ambiente temperatura"
    accuracy_decimals: 1
    internal: true

  - platform: template
    id: amb_hum
    name: "Ambiente humedad"
    accuracy_decimals: 0
    internal: true

  - platform: template
    id: asiento_temp
    name: "Temperatura asiento doble"
    accuracy_decimals: 1
    internal: true

  # Agua (niveles; quedan en -- hasta calibrar los depositos en Venus)
  - platform: template
    id: agua_limpias_nivel
    name: "Agua limpias nivel"
    accuracy_decimals: 0
    internal: true

  - platform: template
    id: agua_grises_nivel
    name: "Agua grises nivel"
    accuracy_decimals: 0
    internal: true

text_sensor:
  - platform: wifi_info
    ip_address:
      id: ip_panel
      name: "Direccion IP"

    mac_address:
      name: "Direccion MAC"

  # ----- Energia -----
  - platform: mqtt_subscribe
    id: raw_bateria_v
    name: "Raw bateria V"
    topic: "N/${portal_venus}/system/0/Dc/Battery/Voltage"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(bateria_v).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_bateria_soc
    name: "Raw bateria SOC"
    topic: "N/${portal_venus}/battery/289/Soc"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(bateria_soc).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_solar_w
    name: "Raw solar W"
    topic: "N/${portal_venus}/solarcharger/288/Yield/Power"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(solar_w).publish_state(root["value"].as<float>());
              return true;
            });

  # ----- Consumo -----
  - platform: mqtt_subscribe
    id: raw_consumo_w
    name: "Raw consumo W"
    topic: "N/${portal_venus}/system/0/Dc/System/Power"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(consumo_w).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_bat_corriente
    name: "Raw corriente bateria"
    topic: "N/${portal_venus}/system/0/Dc/Battery/Current"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(bat_corriente).publish_state(root["value"].as<float>());
              return true;
            });

  # ----- Ambiente -----
  - platform: mqtt_subscribe
    id: raw_amb_temp
    name: "Raw ambiente temperatura"
    topic: "N/${portal_venus}/temperature/102/Temperature"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(amb_temp).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_amb_hum
    name: "Raw ambiente humedad"
    topic: "N/${portal_venus}/temperature/102/Humidity"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(amb_hum).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_asiento_temp
    name: "Raw temperatura asiento doble"
    topic: "N/${portal_venus}/temperature/101/Temperature"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(asiento_temp).publish_state(root["value"].as<float>());
              return true;
            });

  # ----- Agua -----
  - platform: mqtt_subscribe
    id: raw_agua_limpias_nivel
    name: "Raw agua limpias nivel"
    topic: "N/${portal_venus}/tank/23/Level"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(agua_limpias_nivel).publish_state(root["value"].as<float>());
              return true;
            });

  - platform: mqtt_subscribe
    id: raw_agua_grises_nivel
    name: "Raw agua grises nivel"
    topic: "N/${portal_venus}/tank/22/Level"
    internal: true
    on_value:
      then:
        - lambda: |-
            id(ultimo_dato_mqtt) = millis();
            json::parse_json(x, [](JsonObject root) -> bool {
              if (!root["value"].isNull()) id(agua_grises_nivel).publish_state(root["value"].as<float>());
              return true;
            });

  # ----- Relés del Dingtian: llegan como texto ON u OFF -----
  - platform: mqtt_subscribe
    id: rele_frigorifico
    name: "Rele frigorifico"
    topic: "/${dingtian}/out/r6"
    internal: true
    on_value:
      then:
        - lambda: 'id(ultimo_dato_mqtt) = millis();'

  - platform: mqtt_subscribe
    id: rele_tomas_usb
    name: "Rele tomas USB"
    topic: "/${dingtian}/out/r10"
    internal: true
    on_value:
      then:
        - lambda: 'id(ultimo_dato_mqtt) = millis();'

  - platform: mqtt_subscribe
    id: rele_tomas_12v
    name: "Rele tomas 12V"
    topic: "/${dingtian}/out/r11"
    internal: true
    on_value:
      then:
        - lambda: 'id(ultimo_dato_mqtt) = millis();'

  - platform: mqtt_subscribe
    id: rele_inversor
    name: "Rele inversor"
    topic: "/${dingtian}/out/r16"
    internal: true
    on_value:
      then:
        - lambda: 'id(ultimo_dato_mqtt) = millis();'

  - platform: mqtt_subscribe
    id: rele_luz_salon
    name: "Rele luz salon"
    topic: "/${dingtian}/out/r1"
    internal: true
    on_value:
      then:
        - lambda: 'id(ultimo_dato_mqtt) = millis();'

  - platform: mqtt_subscribe
    id: rele_luz_cama
